# Copy to deploy/private-alpha.env on the API host; do not commit that file.
# Owner: API operator | Surface: persistent Fastify API server
# ORCHESTRAT_DATABASE_URL, SUPABASE_S3_SECRET_ACCESS_KEY, and
# DOCUMENT_STORAGE_S3_SECRET_ACCESS_KEY are server secrets; inject them through the host
# secret store. The remaining API values are server configuration.
ORCHESTRAT_DATABASE_URL=postgresql://<supabase-db-user>:<password>@<supabase-db-host>:5432/postgres
ORCHESTRAT_API_HOST=0.0.0.0
ORCHESTRAT_API_PORT=3001
# Provider-injected HOST/PORT are accepted only when the ORCHESTRAT values above are absent.
HOST=0.0.0.0
PORT=3001
# Consumed by the API server and native desktop build; server/public config, not a secret.
ORCHESTRAT_SUPABASE_URL=https://<project-ref>.supabase.co
ORCHESTRAT_SUPABASE_JWT_AUDIENCE=authenticated
ORCHESTRAT_SUPABASE_JWT_ALGORITHM=ES256
ORCHESTRAT_ALLOWED_ORIGINS=https://orchestrat.dev,https://app.orchestrat.dev,tauri://localhost

# Owner: API operator | Surface: optional server-side public avatar object storage (Supabase)
# SUPABASE_S3_SECRET_ACCESS_KEY is a server secret; the others are server config.
SUPABASE_AVATAR_BUCKET=<avatar-bucket>
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=<s3-region>
SUPABASE_S3_ACCESS_KEY_ID=<s3-access-key-id>
SUPABASE_S3_SECRET_ACCESS_KEY=<s3-secret-access-key>

# Owner: API operator | Surface: optional server-side private document storage (Cloudflare R2)
# Keep this bucket private. The secret access key is a server secret; never expose these values to
# Vite, Tauri, or browser code. R2's S3 API region is always auto.
DOCUMENT_STORAGE_BUCKET=<private-r2-document-bucket>
DOCUMENT_STORAGE_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
DOCUMENT_STORAGE_S3_REGION=auto
DOCUMENT_STORAGE_S3_ACCESS_KEY_ID=<r2-access-key-id>
DOCUMENT_STORAGE_S3_SECRET_ACCESS_KEY=<r2-secret-access-key>

# Owner: Vercel dashboard project settings + native release builder | Surface: shared dashboard build-public value
VITE_API_URL=https://api.orchestrat.dev

# Owner: Vercel project settings | Surface: web-only dashboard build-public values
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<public-key>
VITE_WEB_AUTH_CALLBACK_URL=https://app.orchestrat.dev/auth/callback

# Owner: Vercel project settings | Surface: landing server configuration
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<public-key>

# Owner: release builder | Surface: native desktop build-public values
ORCHESTRAT_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<public-key>
ORCHESTRAT_AUTH_ENVIRONMENT=production
ORCHESTRAT_DESKTOP_AUTH_REDIRECT_URI=dev.orchestrat.app://auth/callback
ORCHESTRAT_DESKTOP_AUTH_PORTAL_URL=https://app.orchestrat.dev/auth/desktop

# Owner: release builder | Surface: native macOS signing/notarization inputs
# Supply these only through the release environment; never commit identities or credentials.
# APPLE_SIGNING_IDENTITY
# APPLE_ID + APPLE_PASSWORD + APPLE_TEAM_ID
# Or App Store Connect API-key auth: APPLE_API_KEY + APPLE_API_ISSUER + APPLE_API_KEY_PATH

# Topology constraint: keep exactly one API replica; realtime tickets/connections are in memory.
# Apply migrations separately with: docker compose --profile migration -f deploy/private-alpha.compose.yml run --rm migrate
