{
  "name": "orchestrat",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @orchestrat/api dev",
    "dev:dashboard": "pnpm --filter @orchestrat/dashboard dev",
    "dev:landing": "pnpm --filter @orchestrat/landing dev",
    "cli:install": "pnpm --filter @orchestrat/cli... build && node scripts/install-local-cli.mjs",
    "db:generate": "pnpm --filter @orchestrat/db generate",
    "db:migrate": "pnpm --filter @orchestrat/db migrate",
    "db:seed": "pnpm --filter @orchestrat/db seed",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  }
}
