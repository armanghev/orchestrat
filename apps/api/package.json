{
  "name": "@orchestrat/api",
  "version": "0.1.0",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/routes/*.test.js dist/operations/*.test.js dist/services/*.test.js",
    "test:storage": "node --test dist/operations/*.test.js dist/services/*.test.js",
    "test:postgres": "node --test dist/operations/postgres-acceptance.integration.test.js dist/operations/branches-postgres.integration.test.js",
    "storage:backfill": "node dist/operations/backfill-document-storage.js",
    "storage:gc": "node dist/operations/gc-document-storage.js",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/websocket": "^11.3.0",
    "@orchestrat/auth": "workspace:*",
    "@orchestrat/config": "workspace:*",
    "@orchestrat/db": "workspace:*",
    "@orchestrat/logger": "workspace:*",
    "@orchestrat/protocol": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.5.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "jose": "^6.2.8",
    "pg-mem": "^3.0.14",
    "tsx": "^4.20.5"
  }
}
