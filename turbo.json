{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^build"] },
    "@orchestrat/landing#typecheck": { "dependsOn": ["build"] },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "env": ["ORCHESTRAT_TEST_POSTGRES_URL"]
    }
  }
}
