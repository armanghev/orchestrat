# API server
ORCHESTRAT_API_HOST=0.0.0.0
ORCHESTRAT_API_PORT=8801
ORCHESTRAT_DATABASE_URL=postgresql://orchestrat:orchestrat@localhost:5432/orchestrat
ORCHESTRAT_ALLOWED_ORIGINS=http://localhost:8813
# Who may create accounts after the first (admin) one: invite | open | closed
ORCHESTRAT_SIGNUP=invite

# Optional server-side public avatar object storage (Supabase)
SUPABASE_AVATAR_BUCKET=avatars
SUPABASE_S3_ENDPOINT=https://example.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY_ID=your_server_access_key
SUPABASE_S3_SECRET_ACCESS_KEY=your_server_secret_key

# Optional server-side private document revisions and attachments (Cloudflare R2)
DOCUMENT_STORAGE_BUCKET=orchestrat-documents
DOCUMENT_STORAGE_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
DOCUMENT_STORAGE_S3_REGION=auto
DOCUMENT_STORAGE_S3_ACCESS_KEY_ID=your_r2_access_key_id
DOCUMENT_STORAGE_S3_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Dashboard
VITE_API_URL=http://localhost:8801

# Dashboard desktop (native auth)
ORCHESTRAT_SUPABASE_URL=https://example.supabase.co
ORCHESTRAT_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
ORCHESTRAT_AUTH_ENVIRONMENT=development
ORCHESTRAT_DESKTOP_AUTH_REDIRECT_URI=dev.orchestrat.app://auth/callback
ORCHESTRAT_DESKTOP_AUTH_PORTAL_URL=http://localhost:8813/auth/desktop

# Optional database seed (use a Supabase user UUID)
ORCHESTRAT_SEED_USER_EMAIL=you@example.com
ORCHESTRAT_SEED_USER_NAME=Local developer
ORCHESTRAT_SEED_USER_PASSWORD=change-me-local-dev

# Landing waitlist (server only, never prefix these with NEXT_PUBLIC_)
WAITLIST_DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require&channel_binding=require"
# Set these landing values in apps/landing/.env.local and the Vercel landing project.
# Verify orchestrat.dev in Resend to send from welcome@orchestrat.dev.
# Missing credentials or delivery failures are logged; the signup stays saved.
RESEND_API_KEY=
