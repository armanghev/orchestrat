# API server
ORCHESTRAT_API_HOST=0.0.0.0
ORCHESTRAT_API_PORT=3001
ORCHESTRAT_DATABASE_URL=postgresql://orchestrat:orchestrat@localhost:5432/orchestrat
ORCHESTRAT_ALLOWED_ORIGINS=http://localhost:5173

# Dashboard
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://example.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
VITE_WEB_AUTH_CALLBACK_URL=http://localhost:5173/auth/callback

# Dashboard desktop (native auth)
ORCHESTRAT_SUPABASE_URL=https://example.supabase.co
ORCHESTRAT_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
ORCHESTRAT_AUTH_ENVIRONMENT=development
ORCHESTRAT_DESKTOP_AUTH_REDIRECT_URI=dev.orchestrat.app://auth/callback
ORCHESTRAT_DESKTOP_AUTH_PORTAL_URL=http://localhost:5173/auth/desktop

# Optional database seed (use a Supabase user UUID)
ORCHESTRAT_SEED_AUTH_SUBJECT=00000000-0000-0000-0000-000000000000
ORCHESTRAT_SEED_USER_EMAIL=you@example.com
ORCHESTRAT_SEED_USER_NAME=Local developer

# Landing waitlist (server only, never prefix these with NEXT_PUBLIC_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
